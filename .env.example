# Copy this file to .env and fill in real values before running docker compose up

# --- Session security ---
SESSION_SECRET=change-this-to-a-long-random-string

# --- First-run default login (only used the very first time, to seed the users table) ---
DEFAULT_USERNAME=megan
DEFAULT_PASSWORD=change-this-before-first-run

# --- App URL (used for Google OAuth redirect — must match exactly what's
# registered in Google Cloud Console) ---
APP_URL=https://daily.megangibbs.net

# --- Google Calendar OAuth (from Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Med & Appointment Tracker sync (read-only, same server) ---
# Container name + internal port, once both are on the shared Docker network —
# not the host-mapped port (e.g. http://med-tracker:3000, not 127.0.0.1:3030)
MEDTRACKER_API_URL=http://med-tracker:3000
# Must match APPT_API_KEY set in Med & Appointment Tracker's own .env
MEDTRACKER_API_KEY=

# --- iCal feed for Apple/Google Calendar subscription ---
# Generate with: openssl rand -hex 32
# The feed URL (with this key) grants read-only calendar access to anyone who
# has it, with no login — treat it like a password, don't share it publicly.
ICAL_FEED_KEY=

# --- iOS Scriptable widget (read-only "today's schedule" endpoint) ---
# Generate with: openssl rand -hex 32
WIDGET_API_KEY=

PORT=3000
